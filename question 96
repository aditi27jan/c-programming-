#include <stdio.h>
int main()
{
    int n, i;
    printf("Enter size of array: ");
    scanf("%d", &n);
    int nums[n], answer[n];
    printf("Enter array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }
    int prefix = 1;
    for(i = 0; i < n; i++)
    {
        answer[i] = prefix;
        prefix = prefix * nums[i];
    }
    int suffix = 1;
    for(i = n - 1; i >= 0; i--)
    {
        answer[i] = answer[i] * suffix;
        suffix = suffix * nums[i];
    }
    printf("Answer array: ");
    for(i = 0; i < n; i++)
    {
        printf("%d ", answer[i]);
    }
    return 0;
}
