#include <stdio.h>
int main() {
    int n, i, j, x;
    scanf("%d", &n);
    int a[n + 1];
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    scanf("%d", &x);
    i = n - 1;
    while (i >= 0 && a[i] > x) {
        a[i + 1] = a[i];
        i--;
    }
    a[i + 1] = x;
    for (j = 0; j <= n; j++) {
        printf("%d", a[j]);
        if (j < n) {
            printf(" ");
        }
    }
    return 0;
}
