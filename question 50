#include <stdio.h>
int main()
{
    int i, j;
    for (i = 1; i <= 5; i++)
    {
        if (i == 1)
        {
            printf("*\n");
        }
        else if (i == 2)
        {
            for (j = 1; j <= 4; j++)
                printf("*\n");
        }
        else if (i == 3)
        {
            for (j = 1; j <= 5; j++)
                printf("*\n");
        }
        else if (i == 4)
        {
            for (j = 1; j <= 3; j++)
                printf("*\n");
        }
        else
        {
            printf("*\n");
        }
        printf("\n");
    }
    return 0;
}
