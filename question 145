/*
Q145: Return a structure containing top student's details from a function.

Sample Test Cases:
Input 1:
3 students: Riya 101 89, Karan 102 96, Meena 103 92
Output 1:
Top Student: Karan | Roll: 102 | Marks: 96

*/
#include <stdio.h>

struct Student
{
    char name[20];
    int roll_no;
    int marks;
};

struct Student getTopStudent(struct Student students[], int n)
{
    int i, top = 0;

    for(i = 1; i < n; i++)
    {
        if(students[i].marks > students[top].marks)
        {
            top = i;
        }
    }

    return students[top];
}

int main()
{
    struct Student students[3] = {
        {"Riya", 101, 89},
        {"Karan", 102, 96},
        {"Meena", 103, 92}
    };
    struct Student top;

    top = getTopStudent(students, 3);
    printf("Top Student: %s | Roll: %d | Marks: %d\n",
           top.name, top.roll_no, top.marks);

    return 0;
}
