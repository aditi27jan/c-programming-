#include <stdio.h>
int main()
{
    int n, i, target;
    int first = -1, last = -1;
    printf("Enter size of array: ");
    scanf("%d", &n);
    int nums[n];
    printf("Enter sorted array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }
    printf("Enter target: ");
    scanf("%d", &target);
    for(i = 0; i < n; i++)
    {
        if(nums[i] == target)
        {
            first = i;
            break;
        }
    }
    for(i = n - 1; i >= 0; i--)
    {
        if(nums[i] == target)
        {
            last = i;
            break;
        }
    }
    if(first != -1)
    {
        printf("First occurrence = %d\n", nums[first]);
        printf("Last occurrence = %d\n", nums[last]);
        printf("First index = %d\n", first);
        printf("Last index = %d\n", last);
    }
    else
    {
        printf("-1, -1\n");
    }
    return 0;
}
