#include <stdio.h>

int main()
{
    char s[100], t[100];
    int i, count[26] = {0};

    printf("Enter first string: ");
    scanf("%s", s);

    printf("Enter second string: ");
    scanf("%s", t);

    // Count characters of first string
    for(i = 0; s[i] != '\0'; i++)
    {
        count[s[i] - 'a']++;
    }

    // Decrease count using second string
    for(i = 0; t[i] != '\0'; i++)
    {
        count[t[i] - 'a']--;
    }

    // Check character frequencies
    for(i = 0; i < 26; i++)
    {
        if(count[i] != 0)
        {
            printf("Not Anagram");
            return 0;
        }
    }

    printf("Anagram");

    return 0;
}
