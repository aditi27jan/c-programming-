#include <stdio.h>
#include <math.h>
int main()
{
    float a, b, c, root1, root2, d;
    printf("enter the value of a,b,c");
    scanf("%f %f %f", &a, &b, &c);
    d = b*b - 4*a*c;
    if (d < 0)
    {
        printf("roots are imaginary");
    }
    else
    {
        root1 = (-b + sqrt(d)) / (2*a);
        root2 = (-b - sqrt(d)) / (2*a);
        printf("roots of quadratic equation are %f,%f", root1, root2);
        printf("roots are real");
    }
    return 0;
}
