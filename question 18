#include <stdio.h>

int main()
{
    int a, b, c;
    printf("enter three sides of triangle");
    scanf("%d %d %d", &a, &b, &c);
    if ((a == b) && (b == c) && (c == a))
    {
        printf("given triangle is a equilateral");
    }
    else if ((a != b) && (b != c) && (c != a))
    {
        printf("given triangle is scalene");
    }
    else if ((a == b) || (b == c) || (c == a))
    {
        printf("given triangle is a isosceles");
    }
    else
    {
        printf("not a triangle");
    }
    return 0;
}
