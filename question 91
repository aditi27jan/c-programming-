#include <stdio.h>

int main()
{
    int n, i, total = 0, leftSum = 0;
    printf("Enter size of array: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
        total += arr[i];
    }
    for(i = 0; i < n; i++)
    {
        int rightSum = total - leftSum - arr[i];
        if(leftSum == rightSum)
        {
            printf("Pivot index = %d", i);
            return 0;
        }
        leftSum += arr[i];
    }
      printf("-1");
    return 0;
}
