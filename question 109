#include <stdio.h>
int main()
{
    FILE *fp;
    char name[50];
    int age;
    fp = fopen("info.txt", "w");
    printf("Enter your name: ");
    scanf("%s", name);
    printf("Enter your age: ");
    scanf("%d", &age);
    fprintf(fp, "Name: %s\nAge: %d", name, age);
    fclose(fp);
    printf("Data successfully saved to file.");
    return 0;
}
