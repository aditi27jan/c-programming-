#include <stdio.h>

int main()
{
    int n, i, x;

    printf("Enter size of array: ");
    scanf("%d", &n);

    int arr[n];
    int freq[n + 1];

    for(i = 0; i <= n; i++)
    {
        freq[i] = 0;
    }

    printf("Enter array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    for(i = 0; i < n; i++)
    {
        x = arr[i];

        if(freq[x] == 1)
        {
            printf("Repeated element = %d", x);
            break;
        }

        freq[x] = 1;
    }

    return 0;
}
