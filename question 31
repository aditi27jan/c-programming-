#include <stdio.h>
int main() 
{
    int n,original;
    int rev = 0;  
    printf("Enter the number: ");
    scanf("%d", &n);
    original=n; 
    while (n!= 0) 
    {
        int d=n%10;
        rev=(rev * 10)+d;
        n=n/10;
    }
    if (original==rev){
        printf("pallindrome number");
    }else{
          printf("not a pallindrome number");
    }
    return 0;
}
