#include <stdio.h>
int main() {
    FILE *fp;
    int num, sum = 0, count = 0;
    float average;
    fp = fopen("numbers.txt", "r");
    if (fp == NULL) {
        printf("Error: Could not open numbers.txt\n");
        return 1;
    }
    while (fscanf(fp, "%d", &num) == 1) {
        sum += num;
        count++;
    }
    if (count > 0) {
        average = (float)sum / count;
        printf("Sum: %d\n", sum);
        printf("Average: %.2f\n", average);
    } else {
        printf("No integers found in numbers.txt\n");
    }
    fclose(fp);
    return 0;
}
