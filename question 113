#include <stdio.h>
int main()
{
    FILE *fp;
    char text[100];
    fp = fopen("data.txt", "a");
    if (fp == NULL)
    {
        printf("File cannot be opened.");
        return 1;
    }
    printf("Enter text to append: ");
    fgets(text, 100, stdin);
    fprintf(fp, "%s", text);
    fclose(fp);
    printf("Text appended successfully.");
    return 0;
}
